.error-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 160rpx 40rpx 60rpx;
}

.error-card {
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(111, 91, 69, 0.14);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 20rpx 60rpx rgba(77, 59, 40, 0.08);
  text-align: center;
}

.error-title {
  font-size: 34rpx;
  font-weight: 600;
}

.error-text {
  margin-top: 18rpx;
  color: #81756a;
  font-size: 26rpx;
}

.retry-button {
  width: 260rpx;
  margin-top: 42rpx;
  border: 0;
  border-radius: 999rpx;
  background: #70573f;
  color: #ffffff;
  font-size: 28rpx;
}

.retry-button::after {
  border: 0;
}
