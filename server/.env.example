# 复制本文件为 .env，填入真实 Key
# .env 已加入 .gitignore，不会被提交到仓库

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选
PORT=3001
DEEPSEEK_MODEL=deepseek-chat
# 切换推理模型：DEEPSEEK_MODEL=deepseek-reasoner

# 生产环境填写你的前端域名（逗号分隔），开发阶段留空即允许所有来源
# ALLOWED_ORIGINS=https://fc842598.github.io,https://your-domain.com

# 联系表单邮件通知
CONTACT_NOTIFY_TO=842598522@qq.com
CONTACT_SMTP_HOST=smtp.qq.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=your_mail@qq.com
CONTACT_SMTP_PASS=your_smtp_authorization_code
# 可选，不填则默认使用 CONTACT_SMTP_USER
# CONTACT_FROM="阅天联系表单 <your_mail@qq.com>"
CONTACT_ADMIN_TOKEN=change_this_to_a_long_random_token
